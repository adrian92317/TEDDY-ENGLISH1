    "es_hola": {
      "lang": "es",
      "text": "¡Hola, Adriel! Soy Teddy, tu amigo."
    },
    "es_hoy": {
      "lang": "es",
      "text": "Hoy vamos a jugar con colores en inglés."
    },
    "es_sientes": {
      "lang": "es",
      "text": "Antes de empezar, ¿cómo te sientes hoy? Toca una carita."
    },
    "es_sientes_bien": {
      "lang": "es",
      "text": "¡Qué bueno! Entonces vamos con toda la energía."
    },
    "es_sientes_regular": {
      "lang": "es",
      "text": "Está bien. Vamos despacito y juntos."
    },
    "es_sientes_mal": {
      "lang": "es",
      "text": "Gracias por contarme. Hoy haremos algo cortito y divertido."
    },
    "es_cuento_1": {
      "lang": "es",
      "text": "Escucha este cuento. Teddy tenía cuatro pelotas de colores."
    },
    "es_cuento_2": {
      "lang": "es",
      "text": "Pero un día, ¡las pelotas se escondieron por todo el cuarto!"
    },
    "es_ayudame": {
      "lang": "es",
      "text": "¿Me ayudas a encontrarla? Toca"
    },
    "es_cuento_fin": {
      "lang": "es",
      "text": "¡Las encontramos todas! Gracias, Adriel."
    },
    "es_explora": {
      "lang": "es",
      "text": "Toca cada pelota y escucha su color en inglés."
    },
    "es_explora_listo": {
      "lang": "es",
      "text": "¡Ya conoces los cuatro colores!"
    },
    "es_juego_rapido": {
      "lang": "es",
      "text": "Juguemos un juego rápido. Yo digo un color y tú tocas la pelota."
    },
    "es_ese_es": {
      "lang": "es",
      "text": "Mmm, ese es"
    },
    "es_buscamos": {
      "lang": "es",
      "text": "Estamos buscando"
    },
    "es_intenta": {
      "lang": "es",
      "text": "Intenta otra vez."
    },
    "es_mira_aqui": {
      "lang": "es",
      "text": "Mira, está por aquí."
    },
    "es_escucha_bien": {
      "lang": "es",
      "text": "Escucha bien, despacito."
    },
    "es_teddy_dice_intro": {
      "lang": "es",
      "text": "Ahora, ¡a moverse! Cuando Teddy diga algo, hazlo con tu cuerpo y luego toca el botón verde."
    },
    "es_teddy_dice_listo": {
      "lang": "es",
      "text": "¡Qué bien te mueves!"
    },
    "es_mira_teddy": {
      "lang": "es",
      "text": "Mira lo que hace Teddy con la pelota."
    },
    "es_dentro_de_la_caja": {
      "lang": "es",
      "text": "Dentro de la caja se dice"
    },
    "es_encima_de_la_cama": {
      "lang": "es",
      "text": "Encima de la cama se dice"
    },
    "es_debajo_de_la_cama": {
      "lang": "es",
      "text": "Debajo de la cama se dice"
    },
    "es_toca_para_ver": {
      "lang": "es",
      "text": "Toca cada lugar para verlo otra vez. Cuando estés listo, toca el botón verde."
    },
    "es_arrastra_intro": {
      "lang": "es",
      "text": "Ahora tú mueves las pelotas. Escucha y arrástrala con el dedo."
    },
    "es_casi": {
      "lang": "es",
      "text": "¡Casi!"
    },
    "es_esa_es_la_pelota": {
      "lang": "es",
      "text": "Esa es la pelota"
    },
    "es_queremos_la": {
      "lang": "es",
      "text": "Queremos la pelota"
    },
    "es_la_pusiste": {
      "lang": "es",
      "text": "La pusiste"
    },
    "es_queremos": {
      "lang": "es",
      "text": "Queremos"
    },
    "es_pista_lugar": {
      "lang": "es",
      "text": "Mira dónde brilla."
    },
    "es_juntos": {
      "lang": "es",
      "text": "Hagámoslo juntos. Mira cómo lo hago yo."
    },
    "es_ahora_tu": {
      "lang": "es",
      "text": "Ahora tú."
    },
    "es_mas_tarde": {
      "lang": "es",
      "text": "No pasa nada. Lo practicamos otra vez más tarde."
    },
    "es_mas_pelotas": {
      "lang": "es",
      "text": "¡Lo estás haciendo muy bien! Ahora con más pelotas."
    },
    "es_donde_intro": {
      "lang": "es",
      "text": "Ahora te pregunto yo. Mira dónde está la pelota y toca el dibujo correcto."
    },
    "es_eso_es": {
      "lang": "es",
      "text": "Mmm, eso es"
    },
    "es_mira_bien": {
      "lang": "es",
      "text": "Mira bien dónde está."
    },
    "es_escondidas_intro": {
      "lang": "es",
      "text": "¡A jugar a las escondidas! Cierra los ojos. Teddy se va a esconder."
    },
    "es_encontraste": {
      "lang": "es",
      "text": "¡Me encontraste!"
    },
    "es_no_estoy_ahi": {
      "lang": "es",
      "text": "Ahí no estoy. ¡Sigue buscando!"
    },
    "es_hablar_intro": {
      "lang": "es",
      "text": "Ahora te toca hablar. Escucha, y cuando el micrófono se ponga verde, repite en voz alta."
    },
    "es_buen_intento": {
      "lang": "es",
      "text": "¡Buen intento! Escucha otra vez."
    },
    "es_toca_en_vez": {
      "lang": "es",
      "text": "¡Muy bien por intentarlo! Ahora tócala."
    },
    "es_no_mic": {
      "lang": "es",
      "text": "Hoy no te escucho bien. Sigamos tocando."
    },
    "es_corrige_intro": {
      "lang": "es",
      "text": "A veces Teddy se equivoca. Si digo algo mal, toca la carita triste. Si está bien, toca la feliz."
    },
    "es_teddy_bien": {
      "lang": "es",
      "text": "¡Sí! Teddy dijo bien."
    },
    "es_me_equivoque": {
      "lang": "es",
      "text": "¡Uy, me equivoqué! Ayúdame: pon la pelota donde estaba."
    },
    "es_seguro": {
      "lang": "es",
      "text": "Mmm, mira otra vez. ¿Seguro?"
    },
    "es_gracias_profe": {
      "lang": "es",
      "text": "¡Gracias, profe Adriel!"
    },
    "es_mas_dificil": {
      "lang": "es",
      "text": "¿Quieres uno más difícil?"
    },
    "es_aun_no": {
      "lang": "es",
      "text": "Está bien, seguimos así."
    },
    "es_reto": {
      "lang": "es",
      "text": "¡Reto aceptado!"
    },
    "es_canto_intro": {
      "lang": "es",
      "text": "¡Hora de cantar! Toca el tambor cada vez que escuches un color."
    },
    "es_canto_fin": {
      "lang": "es",
      "text": "¡Qué buen ritmo!"
    },
    "es_mision": {
      "lang": "es",
      "text": "Tengo una misión para ti en tu casa."
    },
    "es_mision_foto": {
      "lang": "es",
      "text": "Cuando lo encuentres, pídele a un adulto que le tome una foto."
    },
    "es_mision_adulto": {
      "lang": "es",
      "text": "Adulto: si la foto está bien, toca el pulgar arriba."
    },
    "es_mision_luego": {
      "lang": "es",
      "text": "También puedes hacerla más tarde."
    },
    "es_toca_tarjeta": {
      "lang": "es",
      "text": "Toca la tarjeta de la lección para terminarla."
    },
    "es_estrellas": {
      "lang": "es",
      "text": "¡Ganaste tus estrellas!"
    },
    "es_trofeo": {
      "lang": "es",
      "text": "¡Y lo hiciste perfecto! Te ganaste un trofeo. Tócalo para reclamarlo."
    },
    "es_adios": {
      "lang": "es",
      "text": "¡Nos vemos pronto!"
    },
    "es_ayuda": {
      "lang": "es",
      "text": "¡Aquí estoy! Escucha otra vez."
    },
    "es_te_ayudo": {
      "lang": "es",
      "text": "¿Quieres que te ayude? Toca la mano."
    },
    "es_sigues_ahi": {
      "lang": "es",
      "text": "¿Sigues ahí? Toca la pantalla cuando quieras seguir."
    },
    "es_p_muy_bien": {
      "lang": "es",
      "text": "¡Muy bien!"
    },
    "es_p_genial": {
      "lang": "es",
      "text": "¡Genial!"
    },
    "es_p_rapido": {
      "lang": "es",
      "text": "¡Y fue rapidísimo!"
    }
  }
}